{
  "name": "software-defence-factory",
  "version": "0.15.2",
  "description": "Factory: scoped software delivery and defence investigations with isolated jobs, evidence and review",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "factory": "bin/software-defence-factory.mjs",
    "software-defence-factory": "bin/software-defence-factory.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arcitai/software-and-defence-factory.git"
  },
  "homepage": "https://github.com/arcitai/software-and-defence-factory#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin/",
    "factory/",
    "kit/",
    ".agents/skills/factory-foundation/",
    ".github/ISSUE_TEMPLATE/factory-task.yml",
    ".github/ISSUE_TEMPLATE/bug-report.yml",
    ".github/ISSUE_TEMPLATE/feature-request.yml",
    "docs/workflows.md",
    "docs/definition.md",
    "config/labels.json",
    "scripts/export-kit.mjs",
    "scripts/probe-platform.mjs",
    "scripts/retained-source-fixture.mjs",
    "docs/npm.md",
    "docs/setup.md",
    "docs/services.md",
    "docs/recovery.md",
    "docs/quickstart.md",
    "docs/defence-integration.md",
    "docs/ownership.md",
    "THIRD_PARTY_NOTICES.md",
    "scripts/probe-review.mjs",
    "scripts/probe-web.mjs",
    "scripts/probe-diagnostics.mjs",
    "docs/usage.md",
    "docs/concepts.md",
    "docs/interfaces.md",
    "docs/web-verification.md",
    "docs/integrations.md"
  ],
  "scripts": {
    "factory": "node bin/software-defence-factory.mjs",
    "probe:platform": "node scripts/probe-platform.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs && node --test tests/*.test.mjs && npm run test:dashboard",
    "build:dashboard": "npm --prefix dashboard ci --ignore-scripts && npm --prefix dashboard run build",
    "test:dashboard": "npm --prefix dashboard test",
    "qualify:pi": "FACTORY_REQUIRE_PI=1 node --test tests/pi-local-adapter.test.mjs tests/pi-context.test.mjs tests/pi-context-batch.test.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
