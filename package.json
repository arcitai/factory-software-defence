{
  "name": "factory-software-defence",
  "version": "0.18.10",
  "description": "Factory: native coding-agent Inbox, Foundation and portable ADLC method",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "factory": "bin/software-defence-factory.mjs",
    "factory-software-defence": "bin/software-defence-factory.mjs",
    "software-defence-factory": "bin/software-defence-factory.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arcitai/factory-software-defence.git"
  },
  "homepage": "https://github.com/arcitai/factory-software-defence#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "files": [
    "bin/",
    "factory/",
    "adlc/",
    "VISION.md",
    ".agents/skills/factory-foundation/",
    ".github/ISSUE_TEMPLATE/factory-task.yml",
    ".github/ISSUE_TEMPLATE/bug-report.yml",
    ".github/ISSUE_TEMPLATE/feature-request.yml",
    "docs/",
    "scripts/export-kit.mjs",
    "scripts/probe-harness.mjs",
    "THIRD_PARTY_NOTICES.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "DESIGN.md",
    "SECURITY.md",
    "todo.md"
  ],
  "scripts": {
    "factory": "node bin/software-defence-factory.mjs",
    "probe:codex": "node scripts/probe-harness.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs && node --test tests/*.test.mjs && npm run test:dashboard",
    "build:dashboard": "npm --prefix dashboard ci --ignore-scripts && npm --prefix dashboard run build",
    "test:dashboard": "npm --prefix dashboard test"
  },
  "bundleDependencies": [
    "yaml",
    "@anthropic-ai/claude-agent-sdk"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "yaml": "2.9.1"
  },
  "factoryService": {
    "adoptionGate": 1
  }
}
